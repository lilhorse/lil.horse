{
  "name": "lil-horse",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "NOTION_INCLUDE_DRAFTS=1 node --env-file-if-exists=.env ./node_modules/astro/bin/astro.mjs dev",
    "build": "node --env-file-if-exists=.env ./node_modules/astro/bin/astro.mjs build",
    "build:fixtures": "NOTION_FIXTURES=1 astro build",
    "preview": "astro preview",
    "check": "NOTION_SKIP_SYNC=1 astro check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check:dist": "tsx scripts/check-dist.ts",
    "record:fixtures": "tsx --env-file=.env scripts/record-fixtures.ts",
    "brand": "tsx brand/build.ts",
    "lighthouse": "lhci autorun"
  },
  "dependencies": {
    "@astrojs/rss": "4.0.19",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@notionhq/client": "5.27.0",
    "@resvg/resvg-js": "2.6.2",
    "astro": "7.3.5",
    "astro-expressive-code": "0.44.2",
    "github-slugger": "2.0.0",
    "katex": "0.19.0",
    "p-limit": "7.3.3",
    "pagefind": "1.5.2",
    "satori": "0.35.0",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@expo-google-fonts/jetbrains-mono": "0.4.1",
    "@expo-google-fonts/noto-sans-sc": "0.4.3",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.63.0",
    "@types/node": "~24.19.1",
    "eslint": "10.11.0",
    "eslint-plugin-astro": "3.2.1",
    "globals": "17.13.0",
    "happy-dom": "20.14.5",
    "html-validate": "11.16.1",
    "prettier": "3.9.9",
    "prettier-plugin-astro": "1.1.0",
    "tsx": "4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3",
    "wrangler": "4.147.0"
  }
}
