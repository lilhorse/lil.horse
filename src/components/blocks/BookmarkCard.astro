---
import { hostnameOf, isSafeHref, renderRichText, type LinkResolver } from '../../lib/html';
import type { BookmarkNode } from '../../notion/types';
import Picture from './Picture.astro';

interface Props {
  node: BookmarkNode;
  resolve: LinkResolver;
}

const { node, resolve } = Astro.props;
const { meta } = node;
const href = isSafeHref(node.url) ? node.url : undefined;
const rel = href ? 'noopener noreferrer' : undefined;
const host = hostnameOf(node.url);
const icon =
  meta?.icon &&
  (meta.icon.variants.find((variant) => variant.format === 'webp')?.src ?? meta.icon.src);
---

<figure class="bookmark">
  {meta ? (
    <a class="bookmark-link" href={href} rel={rel}>
      <span class="bookmark-title">{meta.title ?? node.url}</span>{' '}
      {meta.description && (
        <Fragment>
          <span class="bookmark-description">{meta.description}</span>{' '}
        </Fragment>
      )}
      <span class="bookmark-site">
        {icon && (
          <img
            class="bookmark-icon"
            src={icon}
            alt=""
            width="16"
            height="16"
            loading="lazy"
            decoding="async"
          />
        )}
        {meta.siteName && (
          <Fragment>
            <span class="bookmark-site-name">{meta.siteName}</span>{' '}
          </Fragment>
        )}
        <span class="bookmark-host">{host}</span>
      </span>
      {meta.image && <Picture media={meta.image} alt="" sizes="240px" />}
    </a>
  ) : (
    <a href={href} rel={rel}>
      {node.url}
    </a>
  )}
  {node.caption.length > 0 && <figcaption set:html={renderRichText(node.caption, resolve)} />}
</figure>

<style>
  .bookmark-link {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas:
      'title image'
      'description image'
      'site image';
    align-content: start;
    gap: 4px 16px;
    padding: 12px 14px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: none;
    color: var(--fg);
    text-decoration: none;
  }
  .bookmark-link:hover {
    border-color: var(--accent);
  }
  .bookmark-title {
    grid-area: title;
    font-family: var(--font-sans);
    font-weight: 600;
    line-height: 1.4;
  }
  .bookmark-description {
    display: -webkit-box;
    grid-area: description;
    overflow: hidden;
    color: var(--muted);
    font-family: var(--font-sans);
    font-size: 0.875rem;
    line-height: 1.5;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
  }
  .bookmark-site {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    align-items: center;
    grid-area: site;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: var(--text-ui);
  }
  .bookmark-link :global(picture),
  .bookmark-link > :global(img) {
    grid-area: image;
    inline-size: 160px;
  }
  .bookmark-link :global(img:not(.bookmark-icon)) {
    display: block;
    inline-size: 160px;
    block-size: 100%;
    max-block-size: 96px;
    object-fit: cover;
    border-radius: var(--radius-sm);
  }
  @media (max-width: 639.98px) {
    .bookmark-link {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas: 'title' 'description' 'site';
    }
    .bookmark-link :global(picture),
    .bookmark-link > :global(img:not(.bookmark-icon)) {
      display: none;
    }
  }
</style>
