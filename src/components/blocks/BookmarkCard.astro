---
import { hostnameOf, isSafeHref, renderRichText, type LinkResolver } from '../../lib/html';
import type { BookmarkNode } from '../../notion/types';
import Picture from './Picture.astro';

interface Props {
  node: BookmarkNode;
  resolve: LinkResolver;
}

const { node, resolve } = Astro.props;
const { meta } = node;
const href = isSafeHref(node.url) ? node.url : undefined;
const rel = href ? 'noopener noreferrer' : undefined;
const host = hostnameOf(node.url);
const icon =
  meta?.icon &&
  (meta.icon.variants.find((variant) => variant.format === 'webp')?.src ?? meta.icon.src);
---

<figure class="bookmark">
  {meta ? (
    <a class="bookmark-link" href={href} rel={rel}>
      <span class="bookmark-title">{meta.title ?? node.url}</span>{' '}
      {meta.description && (
        <Fragment>
          <span class="bookmark-description">{meta.description}</span>{' '}
        </Fragment>
      )}
      <span class="bookmark-site">
        {icon && (
          <img
            class="bookmark-icon"
            src={icon}
            alt=""
            width="16"
            height="16"
            loading="lazy"
            decoding="async"
          />
        )}
        {meta.siteName && (
          <Fragment>
            <span class="bookmark-site-name">{meta.siteName}</span>{' '}
          </Fragment>
        )}
        <span class="bookmark-host">{host}</span>
      </span>
      {meta.image && <Picture media={meta.image} alt="" sizes="240px" />}
    </a>
  ) : (
    <a href={href} rel={rel}>
      {node.url}
    </a>
  )}
  {node.caption.length > 0 && <figcaption set:html={renderRichText(node.caption, resolve)} />}
</figure>
