---
import type { LinkResolver } from '../../lib/html';
import type { HeadingRef, Node } from '../../notion/types';
import AudioBlock from './AudioBlock.astro';
import BookmarkCard from './BookmarkCard.astro';
import Callout from './Callout.astro';
import CodeBlock from './CodeBlock.astro';
import Columns from './Columns.astro';
import type { BlockContext } from './context';
import DatabaseTable from './DatabaseTable.astro';
import Equation from './Equation.astro';
import Figure from './Figure.astro';
import FileCard from './FileCard.astro';
import Heading from './Heading.astro';
import List from './List.astro';
import PageLink from './PageLink.astro';
import Paragraph from './Paragraph.astro';
import Quote from './Quote.astro';
import TableBlock from './TableBlock.astro';
import TocBlock from './TocBlock.astro';
import Toggle from './Toggle.astro';
import Unsupported from './Unsupported.astro';
import VideoBlock from './VideoBlock.astro';

interface Props {
  nodes: Node[];
  resolve: LinkResolver;
  headings: HeadingRef[];
  priorityImageId?: string | null;
}

const { nodes, resolve, headings, priorityImageId = null } = Astro.props;
const ctx: BlockContext = { resolve, headings, priorityImageId };
const Self = Astro.self;
---

{nodes.map((node) => {
  switch (node.type) {
    case 'paragraph':
      return <Paragraph node={node} ctx={ctx} Blocks={Self} />;
    case 'heading':
      return <Heading node={node} ctx={ctx} Blocks={Self} />;
    case 'list':
      return <List node={node} ctx={ctx} Blocks={Self} />;
    case 'quote':
      return <Quote node={node} ctx={ctx} Blocks={Self} />;
    case 'callout':
      return <Callout node={node} ctx={ctx} Blocks={Self} />;
    case 'toggle':
      return <Toggle node={node} ctx={ctx} Blocks={Self} />;
    case 'columns':
      return <Columns node={node} ctx={ctx} Blocks={Self} />;
    case 'divider':
      return <hr />;
    case 'code':
      return <CodeBlock node={node} resolve={resolve} />;
    case 'equation':
      return <Equation expression={node.expression} />;
    case 'image':
      return (
        <Figure
          media={node.media}
          alt={node.alt}
          caption={node.caption}
          resolve={resolve}
          priority={node.id === priorityImageId}
        />
      );
    case 'video':
      return <VideoBlock node={node} resolve={resolve} />;
    case 'audio':
      return <AudioBlock node={node} resolve={resolve} />;
    case 'file':
      return <FileCard node={node} resolve={resolve} />;
    case 'bookmark':
      return <BookmarkCard node={node} resolve={resolve} />;
    case 'table':
      return <TableBlock node={node} resolve={resolve} />;
    case 'database':
      return <DatabaseTable node={node} resolve={resolve} />;
    case 'toc':
      return <TocBlock headings={headings} />;
    case 'page_link':
      return <PageLink node={node} resolve={resolve} />;
    case 'container':
      return <Self nodes={node.children} {...ctx} />;
    case 'unsupported':
      return <Unsupported node={node} />;
    default:
      return null;
  }
})}
