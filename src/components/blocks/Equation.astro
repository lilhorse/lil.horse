---
import katex from 'katex';
import { KATEX_OPTIONS } from '../../lib/katex';

interface Props {
  expression: string;
}

const html = katex.renderToString(Astro.props.expression, { ...KATEX_OPTIONS, displayMode: true });
---

<div class="equation" tabindex="0" role="group" aria-label="Equation" set:html={html} />

<style>
  .equation {
    overflow-x: auto;
    padding-block: 4px;
  }
</style>
