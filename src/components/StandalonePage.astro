---
import Base from '../layouts/Base.astro';
import { getSiteData } from '../lib/content';
import type { StandalonePageKey } from '../notion/types';
import Blocks from './blocks/Blocks.astro';
import Picture from './blocks/Picture.astro';

interface Props {
  pageKey: StandalonePageKey;
}

const site = await getSiteData();
const page = site.pages.find((entry) => entry.key === Astro.props.pageKey);
if (!page)
  throw new Error(`The "${Astro.props.pageKey}" page is missing from the pages collection`);
---

<Base title={page.title} description={page.content.firstParagraph} hasMath={page.content.hasMath}>
  <article>
    <h1>{page.title}</h1>
    {page.cover && <Picture media={page.cover} alt="" priority />}
    <Blocks
      nodes={page.content.blocks}
      resolve={site.resolve}
      headings={page.content.headings}
      priorityImageId={page.cover ? null : page.content.priorityImageId}
    />
  </article>
</Base>
