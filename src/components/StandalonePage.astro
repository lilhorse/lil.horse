---
import Base from '../layouts/Base.astro';
import { getSiteData } from '../lib/content';
import { excerpt } from '../notion/text';
import type { StandalonePageKey } from '../notion/types';
import Blocks from './blocks/Blocks.astro';
import Picture from './blocks/Picture.astro';
import DocHeader from './shell/DocHeader.astro';
import DocLayout from './shell/DocLayout.astro';

interface Props {
  pageKey: StandalonePageKey;
}

const site = await getSiteData();
const { pageKey } = Astro.props;
const page = site.pages.find((entry) => entry.key === pageKey);
if (!page) throw new Error(`The "${pageKey}" page is missing from the pages collection`);
---

<Base
  title={page.title}
  description={page.content.firstParagraph ? excerpt(page.content.firstParagraph) : null}
  hasMath={page.content.hasMath}
  current={pageKey}
  path={`~/${pageKey}.md`}
  file={pageKey === 'contact' ? 'contact.md' : null}
  wide
>
  <DocLayout headings={page.content.headings} search={{ type: 'page' }}>
    <DocHeader command={`cat ~/${pageKey}.md`} title={page.title} />
    {page.cover && (
      <div class="doc-cover">
        <Picture media={page.cover} alt="" priority />
      </div>
    )}
    <div class="prose">
      <Blocks
        nodes={page.content.blocks}
        resolve={site.resolve}
        headings={page.content.headings}
        priorityImageId={page.cover ? null : page.content.priorityImageId}
      />
    </div>
  </DocLayout>
</Base>
