---
import type { Section } from '../../lib/shell';
import PixelHorse from './PixelHorse.astro';
import SiteMenu from './SiteMenu.astro';

interface Props {
  current: Section | null;
  path: string;
  file: string | null;
}

const TABS: { section: Section; href: string; label: string }[] = [
  { section: 'home', href: '/', label: '~/lil.horse' },
  { section: 'blog', href: '/blog', label: 'blog' },
  { section: 'projects', href: '/projects', label: 'projects' },
  { section: 'about', href: '/about', label: 'about' },
];

const { current, path, file } = Astro.props;
const isPage = (section: Section) => section === current;
---

<header class="site-header">
  <span class="dots" aria-hidden="true">
    <i></i>
    <i></i>
    <i></i>
  </span>
  <nav class="tabs" aria-label="Primary">
    <ul>
      {TABS.map((tab, index) => (
        <Fragment>
          {index > 0 && ' '}
          <li>
            <a
              class:list={['tab', { active: isPage(tab.section) }]}
              href={tab.href}
              aria-current={isPage(tab.section) ? 'page' : undefined}
            >
              {tab.section === 'home' && <PixelHorse grid={16} size={16} />}
              {tab.label}
            </a>
          </li>
        </Fragment>
      ))}
      {file && (
        <Fragment>
          {' '}
          <li aria-hidden="true">
            <span class="tab active">{file}</span>
          </li>
        </Fragment>
      )}
    </ul>
  </nav>
  <a class="home" href="/" aria-label="Home">
    <PixelHorse grid={16} size={16} />
  </a>
  <span class="path">{path}</span>
  <div class="actions">
    <SiteMenu current={current} />
    <button class="theme-toggle" type="button" data-theme-toggle>
      <span class="button">
        <svg class="icon icon-system" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
          <circle
            cx="8"
            cy="8"
            r="6.25"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
          ></circle>
          <path d="M8 1.75a6.25 6.25 0 0 1 0 12.5z" fill="currentColor"></path>
        </svg>
        <svg class="icon icon-light" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
          <circle
            cx="8"
            cy="8"
            r="3.25"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
          ></circle>
          <path
            d="M8 1.5v1.75M8 12.75v1.75M1.5 8h1.75M12.75 8h1.75M3.4 3.4l1.24 1.24M11.36 11.36l1.24 1.24M3.4 12.6l1.24-1.24M11.36 4.64l1.24-1.24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
          ></path>
        </svg>
        <svg class="icon icon-dark" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
          <path d="M13.5 9.6A6 6 0 0 1 6.4 2.5a6 6 0 1 0 7.1 7.1z" fill="currentColor"></path>
        </svg>
        <span class="sr-only">Theme: </span>
        <span class="label label-system">system</span>
        <span class="label label-light">light</span>
        <span class="label label-dark">dark</span>
      </span>
    </button>
  </div>
</header>

<style>
  .site-header {
    position: relative;
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 8px 12px;
    background: var(--bg-bar);
    border-bottom: 1px solid var(--border);
    font-size: var(--text-ui);
    view-transition-name: site-header;
    /* view-transition-name makes this a stacking context; z-index keeps the menu above positioned content. */
    z-index: 20;
  }
  .tab :global(.pixel-horse),
  .home :global(.pixel-horse) {
    view-transition-name: site-logo;
  }
  .dots {
    display: flex;
    gap: 6px;
    margin-inline-end: 8px;
  }
  .dots i {
    inline-size: 10px;
    block-size: 10px;
    border-radius: 50%;
    background: var(--dot-1);
  }
  .dots i:nth-child(2) {
    background: var(--dot-2);
  }
  .dots i:nth-child(3) {
    background: var(--dot-3);
  }
  .tabs ul {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .tab {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-block-size: 28px;
    padding: 4px 10px;
    border: 1px solid transparent;
    border-radius: var(--radius-sm);
    color: var(--muted);
    text-decoration: none;
  }
  a.tab:hover {
    color: var(--fg);
  }
  .tab.active {
    background: var(--bg);
    border-color: var(--border);
    color: var(--fg);
  }
  .home,
  .path {
    display: none;
  }
  .actions {
    display: flex;
    gap: 6px;
    align-items: center;
    margin-inline-start: auto;
  }
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    padding: 0;
    border: 0;
    background: none;
    color: var(--fg);
    font: inherit;
    cursor: pointer;
  }
  .theme-toggle .button {
    display: inline-flex;
    gap: 6px;
    align-items: center;
    block-size: 32px;
    padding-inline: 9px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg);
    font-size: var(--text-ui);
  }
  .theme-toggle:hover .button {
    border-color: var(--accent);
  }
  .icon {
    inline-size: 14px;
    block-size: 14px;
  }
  .icon-light,
  .icon-dark,
  .label-light,
  .label-dark {
    display: none;
  }
  :global(:root[data-theme-pref='light']) .theme-toggle :is(.icon-light, .label-light),
  :global(:root[data-theme-pref='dark']) .theme-toggle :is(.icon-dark, .label-dark) {
    display: inline-block;
  }
  :global(:root[data-theme-pref='light']) .theme-toggle :is(.icon-system, .label-system),
  :global(:root[data-theme-pref='dark']) .theme-toggle :is(.icon-system, .label-system) {
    display: none;
  }
  @media (max-width: 639.98px) {
    .site-header {
      padding-block: 0;
    }
    .dots,
    .tabs {
      display: none;
    }
    .home {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-block-size: 44px;
      min-inline-size: 44px;
      margin-inline-start: -10px;
    }
    .path {
      display: block;
      min-inline-size: 0;
      overflow: hidden;
      color: var(--accent);
      font-weight: 600;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    .theme-toggle {
      justify-content: center;
      min-block-size: 44px;
      min-inline-size: 44px;
    }
  }
</style>
