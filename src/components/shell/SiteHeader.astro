---
import type { Section } from '../../lib/shell';
import PixelHorse from './PixelHorse.astro';
import SiteMenu from './SiteMenu.astro';

interface Props {
  current: Section | null;
  path: string;
  file: string | null;
}

const TABS: { section: Section; href: string; label: string }[] = [
  { section: 'home', href: '/', label: '~/lil.horse' },
  { section: 'blog', href: '/blog', label: 'blog' },
  { section: 'projects', href: '/projects', label: 'projects' },
  { section: 'about', href: '/about', label: 'about' },
];

const { current, path, file } = Astro.props;
const isPage = (section: Section) => section === current;
---

<header class="site-header">
  <span class="dots" aria-hidden="true">
    <i></i>
    <i></i>
    <i></i>
  </span>
  <nav class="tabs" aria-label="Primary">
    <ul>
      {TABS.map((tab, index) => (
        <Fragment>
          {index > 0 && ' '}
          <li>
            <a
              class:list={['tab', { active: isPage(tab.section) }]}
              href={tab.href}
              aria-current={isPage(tab.section) ? 'page' : undefined}
            >
              {tab.section === 'home' && <PixelHorse grid={16} size={16} />}
              {tab.label}
            </a>
          </li>
        </Fragment>
      ))}
      {file && (
        <Fragment>
          {' '}
          <li aria-hidden="true">
            <span class="tab active">{file}</span>
          </li>
        </Fragment>
      )}
    </ul>
  </nav>
  <a class="home" href="/" aria-label="Home">
    <PixelHorse grid={16} size={16} />
  </a>
  <span class="path">{path}</span>
  <SiteMenu current={current} />
</header>

<style>
  .site-header {
    position: relative;
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 8px 12px;
    background: var(--bg-bar);
    border-bottom: 1px solid var(--border);
    font-size: var(--text-ui);
  }
  .dots {
    display: flex;
    gap: 6px;
    margin-inline-end: 8px;
  }
  .dots i {
    inline-size: 10px;
    block-size: 10px;
    border-radius: 50%;
    background: var(--dot-1);
  }
  .dots i:nth-child(2) {
    background: var(--dot-2);
  }
  .dots i:nth-child(3) {
    background: var(--dot-3);
  }
  .tabs ul {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .tab {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-block-size: 28px;
    padding: 4px 10px;
    border: 1px solid transparent;
    border-radius: var(--radius-sm);
    color: var(--muted);
    text-decoration: none;
  }
  a.tab:hover {
    color: var(--fg);
  }
  .tab.active {
    background: var(--bg);
    border-color: var(--border);
    color: var(--fg);
  }
  .home,
  .path {
    display: none;
  }
  @media (max-width: 639.98px) {
    .site-header {
      padding-block: 0;
    }
    .dots,
    .tabs {
      display: none;
    }
    .home {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-block-size: 44px;
      min-inline-size: 44px;
      margin-inline-start: -10px;
    }
    .path {
      display: block;
      min-inline-size: 0;
      overflow: hidden;
      color: var(--accent);
      font-weight: 600;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
  }
</style>
