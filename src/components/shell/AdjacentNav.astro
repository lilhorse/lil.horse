---
interface Neighbour {
  href: string;
  title: string;
  lang?: string | undefined;
}

interface Props {
  label: string;
  previous: Neighbour | null;
  next: Neighbour | null;
  previousLabel: string;
  nextLabel: string;
}

const { label, previous, next, previousLabel, nextLabel } = Astro.props;
---

{(previous || next) && (
  <nav class="adjacent" aria-label={label}>
    {previous && (
      <a class="previous" href={previous.href} rel="prev">
        <span class="direction">
          <span aria-hidden="true">‹</span> {previousLabel}
        </span>{' '}
        <span class="title" lang={previous.lang}>
          {previous.title}
        </span>
      </a>
    )}
    {previous && next && ' '}
    {next && (
      <a class="next" href={next.href} rel="next">
        <span class="direction">
          {nextLabel} <span aria-hidden="true">›</span>
        </span>{' '}
        <span class="title" lang={next.lang}>
          {next.title}
        </span>
      </a>
    )}
  </nav>
)}

<style>
  .adjacent {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    margin-block-start: 40px;
    padding-block-start: 20px;
    border-block-start: 1px solid var(--rule);
  }
  a {
    display: grid;
    gap: 2px;
    padding: 10px 12px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    color: var(--fg);
    text-decoration: none;
  }
  a:hover {
    border-color: var(--accent);
  }
  .next {
    grid-column: 2;
    text-align: end;
  }
  .direction {
    color: var(--muted);
    font-size: var(--text-ui);
  }
  .title {
    font-family: var(--font-sans);
    font-weight: 500;
  }
  @media (max-width: 639.98px) {
    .adjacent {
      grid-template-columns: 1fr;
    }
    .next {
      grid-column: 1;
    }
  }
</style>
