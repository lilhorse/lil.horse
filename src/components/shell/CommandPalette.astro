---
import { htmlLang } from '../../lib/lang';
import { listedPosts } from '../../lib/selectors';
import type { PostEntry, ProfileEntry } from '../../notion/types';
import Prompt from './Prompt.astro';

interface Props {
  posts: PostEntry[];
  profile: ProfileEntry;
}

const NAV = [
  { href: '/', label: 'home', icon: '~' },
  { href: '/blog', label: 'blog', icon: '▸' },
  { href: '/projects', label: 'projects', icon: '▸' },
  { href: '/about', label: 'about', icon: '▸' },
  { href: '/contact', label: 'contact', icon: '▸' },
];
const THEMES = ['system', 'light', 'dark'] as const;

const { posts, profile } = Astro.props;
const recent = listedPosts(posts).slice(0, 5);
const at = profile.email?.lastIndexOf('@') ?? -1;
const email =
  profile.email && at > 0 && at < profile.email.length - 1
    ? { user: profile.email.slice(0, at), host: profile.email.slice(at + 1) }
    : null;
---

<dialog
  class="palette"
  data-palette
  data-email-user={email?.user}
  data-email-host={email?.host}
  aria-label="Command palette"
>
  <div class="box">
    <div class="query">
      <Prompt />
      <label class="sr-only" for="palette-query">
        Search posts, pages and commands
      </label>
      <input
        id="palette-query"
        type="text"
        role="combobox"
        aria-expanded="true"
        aria-controls="palette-options"
        aria-autocomplete="list"
        autocomplete="off"
        autocapitalize="off"
        spellcheck="false"
        placeholder="Type to search…"
      />
      <button class="close" type="button" data-palette-close aria-label="Close">
        esc
      </button>
    </div>
    <div class="theme" role="group" aria-label="Theme">
      {THEMES.map((name) => (
        <button type="button" data-theme-set={name} aria-pressed={name === 'system'}>
          {name}
        </button>
      ))}
    </div>
    <ul id="palette-options" class="options" role="listbox" aria-label="Results and commands">
      <li class="group" role="presentation" data-group="results" hidden>
        <p class="group-label" aria-hidden="true">
          results
        </p>
        <ul role="group" aria-label="Search results" data-results></ul>
      </li>
      <li class="group" role="presentation" data-group="nav">
        <p class="group-label" aria-hidden="true">
          go to
        </p>
        <ul role="group" aria-label="Go to">
          {NAV.map((item, index) => (
            <Fragment>
              {index > 0 && ' '}
              <li
                role="option"
                id={`palette-nav-${item.label}`}
                data-href={item.href}
                data-keywords="go to"
              >
                <span class="icon" aria-hidden="true">
                  {item.icon}
                </span>{' '}
                <span class="label">{item.label}</span>
              </li>
            </Fragment>
          ))}
        </ul>
      </li>
      <li class="group" role="presentation" data-group="recent" hidden={recent.length === 0}>
        <p class="group-label" aria-hidden="true">
          recent posts
        </p>
        <ul role="group" aria-label="Recent posts">
          {recent.map((post, index) => (
            <Fragment>
              {index > 0 && ' '}
              <li
                role="option"
                id={`palette-post-${post.slug}`}
                data-href={`/blog/${post.slug}`}
                data-keywords={post.slug}
              >
                <span class="icon" aria-hidden="true">
                  ▸
                </span>{' '}
                <span class="label" lang={htmlLang(post.language)}>
                  {post.title}
                </span>{' '}
                <span class="meta">{post.published}</span>
              </li>
            </Fragment>
          ))}
        </ul>
      </li>
      <li class="group" role="presentation" data-group="actions">
        <p class="group-label" aria-hidden="true">
          actions
        </p>
        <ul role="group" aria-label="Actions">
          <li
            role="option"
            id="palette-theme"
            data-action="theme"
            data-keywords="theme light dark system"
          >
            <span class="icon" aria-hidden="true">
              ◐
            </span>{' '}
            <span class="label">Switch theme</span> <span class="meta" data-theme-hint></span>
          </li>
          {email && (
            <li
              role="option"
              id="palette-copy-email"
              data-action="copy-email"
              data-keywords="copy email address"
            >
              <span class="icon" aria-hidden="true">
                ⎘
              </span>{' '}
              <span class="label">Copy email</span>
            </li>
          )}{' '}
          {email && (
            <li
              role="option"
              id="palette-email"
              data-action="email"
              data-keywords="email me mail contact"
            >
              <span class="icon" aria-hidden="true">
                @
              </span>{' '}
              <span class="label">Email me</span>
            </li>
          )}{' '}
          <li
            role="option"
            id="palette-rss"
            data-href="/feed.xml"
            data-keywords="rss feed subscribe"
          >
            <span class="icon" aria-hidden="true">
              ▸
            </span>{' '}
            <span class="label">Open RSS feed</span>
          </li>
        </ul>
      </li>
      <li class="group" role="presentation" data-group="empty" hidden>
        <p class="empty">No results</p>
      </li>
    </ul>
  </div>
</dialog>

<style>
  .palette {
    inline-size: min(640px, calc(100vw - 32px));
    max-block-size: min(70vh, 560px);
    margin: 10vh auto 0;
    padding: 0;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg);
    color: var(--fg);
    font-family: var(--font-mono);
    font-size: var(--text-cmd);
    box-shadow: 0 24px 64px rgb(0 0 0 / 0.35);
  }
  .palette::backdrop {
    background: rgb(0 0 0 / 0.45);
  }
  .box {
    display: flex;
    flex-direction: column;
    max-block-size: min(70vh, 560px);
  }
  .query {
    display: flex;
    gap: 10px;
    align-items: center;
    padding: 10px 14px;
    border-block-end: 1px solid var(--border);
  }
  input {
    flex: 1;
    min-inline-size: 0;
    padding: 6px 0;
    border: 0;
    background: none;
    color: var(--fg);
    font: inherit;
  }
  input:focus {
    outline: none;
  }
  input::placeholder {
    color: var(--muted);
  }
  .close {
    padding: 2px 6px;
    border: 1px solid var(--border);
    border-radius: 4px;
    background: var(--bg-bar);
    color: var(--muted);
    font: inherit;
    font-size: 0.75rem;
    cursor: pointer;
  }
  .theme {
    display: none;
    gap: 6px;
    padding: 10px 14px 0;
  }
  .theme button {
    flex: 1;
    min-block-size: 44px;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--bg);
    color: var(--fg);
    font: inherit;
    cursor: pointer;
  }
  .theme button[aria-pressed='true'] {
    border-color: var(--accent);
    color: var(--accent);
  }
  .options {
    flex: 1;
    min-block-size: 0;
    margin: 0;
    padding: 6px;
    overflow-y: auto;
    list-style: none;
  }
  .options ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .group-label {
    margin: 8px 8px 4px;
    color: var(--muted);
    font-size: var(--text-ui);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  /* Search results are built in the browser without Astro's scoping attribute, hence :global. */
  .options :global([role='option']) {
    display: flex;
    flex-wrap: wrap;
    gap: 2px 10px;
    align-items: baseline;
    min-block-size: 40px;
    padding: 8px 10px;
    border-radius: var(--radius-sm);
    cursor: pointer;
  }
  .options :global([role='option'][aria-selected='true']) {
    background: color-mix(in oklab, var(--accent) 14%, transparent);
  }
  .palette [hidden] {
    display: none;
  }
  .icon {
    inline-size: 18px;
    color: var(--accent);
    text-align: center;
  }
  .options :global(.label) {
    color: var(--fg);
  }
  .options :global(.meta) {
    color: var(--muted);
    font-size: var(--text-ui);
  }
  /* --muted falls below 4.5:1 on the selected row's tint. */
  .options :global([aria-selected='true'] .meta) {
    color: var(--fg-soft);
  }
  .options :global(.excerpt) {
    flex-basis: 100%;
    color: var(--fg-soft);
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    line-height: 1.5;
  }
  .options :global(.excerpt mark) {
    background: var(--hl-yellow);
    color: var(--fg);
  }
  .options :global(.note),
  .empty {
    padding: 8px 10px;
    color: var(--muted);
  }
  @media (max-width: 639.98px) {
    .palette {
      inline-size: 100vw;
      max-inline-size: none;
      max-block-size: 100dvh;
      margin: 0;
      border: 0;
      border-radius: 0;
    }
    .box {
      max-block-size: 100dvh;
    }
    .theme {
      display: flex;
    }
    .options :global([role='option']) {
      min-block-size: 44px;
    }
  }
</style>
