---
import { bannerBitmap, bannerLabel, bannerPath, bannerScale, shimmerBand } from '../../lib/banner';
import { emailHtml, socialLinks } from '../../lib/profile';
import type { Availability, MastheadEntry, ProfileEntry } from '../../notion/types';
import PixelHorse from './PixelHorse.astro';
import { siteConfig } from '../../../site.config';

interface Props {
  profile: ProfileEntry;
  masthead: MastheadEntry;
}

const STATUS: Record<Availability, string> = {
  'Open to work': 'open',
  Freelancing: 'freelancing',
  Busy: 'busy',
};

const SWATCHES = [1, 2, 3, 4, 5, 6];

const { profile, masthead } = Astro.props;
const email = profile.email ? emailHtml(profile.email) : null;
const social = socialLinks(profile);
const banner = bannerBitmap(masthead.title, (message) => console.warn(message));
const scale = bannerScale(banner.width);
const band = shimmerBand(banner.width);
// The resting cursor ends the note when the stack row shows one, and the slogan otherwise.
const note = profile.stack.length > 0 ? siteConfig.stackNote.text || null : null;
---

<div class="neofetch" data-intro>
  <PixelHorse grid={24} size={120} animated />
  <div class="info">
    {banner.width > 0 ? (
      <svg
        class="banner"
        role="img"
        aria-label={bannerLabel(masthead.title)}
        viewBox={`0 0 ${banner.width} ${banner.height}`}
        width={banner.width * scale}
        height={banner.height * scale}
        shape-rendering="crispEdges"
      >
        <defs>
          <linearGradient id="masthead-gradient">
            {SWATCHES.map((swatch, index) => (
              <stop offset={`${index * 20}%`} style={`stop-color: var(--swatch-${swatch})`} />
            ))}
          </linearGradient>
          <linearGradient id="masthead-shine">
            <stop offset="0" style="stop-color: #fff0" />
            <stop offset="0.3" style="stop-color: light-dark(#ffffff1f, #ffffff40)" />
            <stop offset="0.5" style="stop-color: light-dark(#ffffff99, #ffffffbf)" />
            <stop offset="0.7" style="stop-color: light-dark(#ffffff1f, #ffffff40)" />
            <stop offset="1" style="stop-color: #fff0" />
          </linearGradient>
          <clipPath id="masthead-ink">
            <use href="#masthead-letters" />
          </clipPath>
        </defs>
        <path id="masthead-letters" fill="url(#masthead-gradient)" d={bannerPath(banner)} />
        <g clip-path="url(#masthead-ink)">
          <rect
            class="shine"
            x={-band}
            y="0"
            width={band}
            height={banner.height}
            fill="url(#masthead-shine)"
            style={`--sweep: ${banner.width + band}px`}
          />
        </g>
      </svg>
    ) : (
      <p class="title">{masthead.title}</p>
    )}
    {masthead.slogan && (
      <p class="slogan" data-slogan>
        <span class="slogan-text">{masthead.slogan}</span>
        {!note && (
          <span class="cursor" aria-hidden="true">
            ▋
          </span>
        )}
      </p>
    )}
    <p class="rule" aria-hidden="true">
      ------------------
    </p>
    <dl>
      <div>
        <dt>Role</dt>
        <dd>{profile.role}</dd>
      </div>
      <div>
        <dt>Location</dt>
        <dd>{profile.location}</dd>
      </div>
      {profile.stack.length > 0 && (
        <div>
          <dt>Stack</dt>
          <dd data-stack>
            {profile.stack.map((item, index) => (
              <Fragment>
                {index > 0 && '\u00a0· '}
                {siteConfig.stackNote.strikethrough ? (
                  <s>{item.replaceAll(' ', '\u00a0')}</s>
                ) : (
                  item.replaceAll(' ', '\u00a0')
                )}
              </Fragment>
            ))}
            {note && (
              <span class="comment" data-note>
                <span class="note-text">{` ${note}`}</span>
                <span class="cursor" aria-hidden="true">
                  ▋
                </span>
              </span>
            )}
          </dd>
        </div>
      )}
      <div>
        <dt>Status</dt>
        <dd class={`status ${STATUS[profile.availability]}`}>
          <span class="dot" aria-hidden="true"></span>
          {profile.availability}
        </dd>
      </div>
      {(email || social.length > 0) && (
        <div>
          <dt>Contact</dt>
          <dd>
            {email && <span set:html={email} />}
            {social.map((link, index) => (
              <Fragment>
                {(email || index > 0) && <span class="sep"> · </span>}
                <a href={link.href} rel="me noopener noreferrer">
                  {link.label}
                </a>
              </Fragment>
            ))}
          </dd>
        </div>
      )}
    </dl>
    <div class="swatches" aria-hidden="true"></div>
    {profile.bio && <p class="bio">{profile.bio}</p>}
  </div>
</div>

<style>
  .neofetch {
    display: flex;
    gap: 24px;
    align-items: center;
  }
  .info {
    min-inline-size: 0;
    line-height: 1.65;
  }
  .banner {
    /* The light swatches fade into the light background without an edge. */
    --banner-edge: light-dark(color-mix(in oklab, var(--fg) 45%, transparent), transparent);
    --banner-glow: light-dark(
      color-mix(in oklab, var(--fg) 22%, transparent),
      color-mix(in oklab, var(--swatch-6) 45%, transparent)
    );
    display: block;
    max-inline-size: 100%;
    block-size: auto;
    filter: drop-shadow(0 0 1px var(--banner-edge)) drop-shadow(0 0 6px var(--banner-glow));
  }
  .title {
    color: var(--accent-2);
    font-weight: 700;
  }
  .slogan {
    position: relative;
    margin-block-start: 6px;
    color: var(--fg-soft);
    font-style: italic;
  }
  .comment {
    position: relative;
    display: inline-block;
    color: var(--muted);
  }
  .cursor {
    color: var(--ok);
    font-style: normal;
    animation: cursor-blink 1s steps(1) infinite;
  }
  @keyframes cursor-blink {
    50% {
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .cursor {
      animation: none;
    }
  }
  .sep {
    color: var(--muted);
  }
  .rule {
    color: var(--faint);
  }
  dl > div {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    column-gap: 1ch;
  }
  /* A long value wraps beside its label instead of dropping below it. */
  dd {
    flex: 1 1 0;
    min-inline-size: 0;
  }
  dt {
    color: var(--accent);
    font-weight: 600;
  }
  dt::after {
    color: var(--fg);
    content: ':';
  }
  .status {
    display: inline-flex;
    gap: 0.6ch;
    align-items: center;
  }
  .dot {
    inline-size: 0.6em;
    block-size: 0.6em;
    border-radius: 50%;
    background: currentColor;
  }
  .open {
    color: var(--ok);
  }
  .freelancing {
    color: var(--accent);
  }
  .busy {
    color: var(--muted);
  }
  .swatches {
    inline-size: 120px;
    block-size: 12px;
    margin-block-start: 8px;
    background: linear-gradient(
      90deg,
      var(--swatch-1) 20px,
      var(--swatch-2) 0 40px,
      var(--swatch-3) 0 60px,
      var(--swatch-4) 0 80px,
      var(--swatch-5) 0 100px,
      var(--swatch-6) 0
    );
  }
  dd a {
    text-decoration-line: none;
  }
  dd a:hover {
    text-decoration-line: underline;
  }
  .bio {
    margin-block-start: 12px;
    color: var(--fg-soft);
    font-family: var(--font-sans);
    font-size: 0.9375rem;
  }
  @media (max-width: 639.98px) {
    .neofetch {
      flex-direction: column;
      align-items: flex-start;
    }
    dd a {
      display: inline-flex;
      align-items: center;
      min-block-size: 44px;
      min-inline-size: 44px;
      /* Keeps the 44 px target without making the row taller than the others. */
      margin-block: calc((1lh - 44px) / 2);
    }
  }
</style>
