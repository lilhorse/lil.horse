---
import Prompt from './Prompt.astro';

interface Props {
  command: string;
  pipe?: string;
  full?: boolean;
  heading?: { level: 1 | 2; text: string } | null;
}

const { command, pipe, full = false, heading = null } = Astro.props;
const Heading = heading ? (`h${heading.level}` as const) : null;
---

<section class="cmd">
  {Heading && <Heading class="sr-only">{heading?.text}</Heading>}
  <p class="cmd-line" aria-hidden="true">
    <Prompt full={full} /> <span class="command">{command}</span>
    {pipe && <span class="pipe"> {pipe}</span>}
  </p>
  <div class="cmd-out">
    <slot />
  </div>
</section>

<style>
  .cmd {
    padding-block: 20px;
    border-bottom: 1px solid var(--rule);
  }
  .cmd:last-child {
    border-bottom: 0;
  }
  .cmd-line {
    font-family: var(--font-mono);
    font-size: var(--text-cmd);
    line-height: 1.6;
    color: var(--fg);
    overflow-wrap: anywhere;
  }
  .pipe {
    color: var(--muted);
  }
  .cmd-out {
    margin-top: 12px;
  }
  .cmd-out:empty {
    display: none;
  }
</style>
