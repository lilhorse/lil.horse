---
import { siteConfig } from '../../../site.config';
import { OG_SIZE } from '../../lib/og';
import { absoluteUrl, jsonLdHtml, type JsonLd } from '../../lib/seo';

interface Props {
  title: string;
  pageTitle: string;
  description: string | null;
  canonicalUrl: string | null;
  noindex: boolean;
  type: 'website' | 'article';
  image: string;
  article: { published: string; modified: string | null; tags: string[] } | null;
  jsonLd: JsonLd[];
}

const { title, pageTitle, description, canonicalUrl, noindex, type, image, article, jsonLd } =
  Astro.props;
const imageUrl = absoluteUrl(image, siteConfig.url);
---

<title>{pageTitle}</title>
{description && <meta name="description" content={description} />}
{canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
{noindex && <meta name="robots" content="noindex" />}
<meta property="og:type" content={type} />
<meta property="og:site_name" content={siteConfig.name} />
<meta property="og:title" content={title} />
{description && <meta property="og:description" content={description} />}
{canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
<meta property="og:image" content={imageUrl} />
<meta property="og:image:width" content={String(OG_SIZE.width)} />
<meta property="og:image:height" content={String(OG_SIZE.height)} />
<meta property="og:image:alt" content={title} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
{description && <meta name="twitter:description" content={description} />}
<meta name="twitter:image" content={imageUrl} />
{article && <meta property="article:published_time" content={article.published} />}
{article?.modified && <meta property="article:modified_time" content={article.modified} />}
{article?.tags.map((tag) => (
  <meta property="article:tag" content={tag} />
))}
{jsonLd.map((data) => (
  <script type="application/ld+json" set:html={jsonLdHtml(data)} />
))}
<link rel="alternate" type="application/rss+xml" title={siteConfig.name} href="/feed.xml" />
