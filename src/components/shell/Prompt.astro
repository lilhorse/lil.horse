---
import { SHELL } from '../../lib/shell';

interface Props {
  full?: boolean;
}

const { full = false } = Astro.props;
---

<span class="prompt">
  {full && (
    <Fragment>
      <span class="user">{SHELL.user}</span> <span class="dim">in</span>{' '}
      <span class="cwd">{SHELL.cwd}</span> <span class="dim">on</span>{' '}
      <span class="branch">{SHELL.branch}</span>{' '}
    </Fragment>
  )}
  <svg class="glyph" viewBox="0 0 12 20" aria-hidden="true" focusable="false">
    <path d="M3 4.5l6.5 5.5-6.5 5.5" fill="none" stroke="currentColor" stroke-width="3"></path>
  </svg>
</span>

<style>
  .prompt {
    white-space: nowrap;
  }
  .user {
    color: var(--user);
  }
  .dim {
    color: var(--muted);
  }
  .cwd {
    color: var(--accent);
    font-weight: 600;
  }
  .branch {
    color: var(--branch);
  }
  .glyph {
    display: inline-block;
    width: 0.6em;
    height: 1em;
    vertical-align: -0.15em;
    color: var(--prompt);
  }
</style>
