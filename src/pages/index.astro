---
import { siteConfig } from '../../site.config';
import CommandBlock from '../components/shell/CommandBlock.astro';
import Neofetch from '../components/shell/Neofetch.astro';
import PostList from '../components/shell/PostList.astro';
import ProjectList from '../components/shell/ProjectList.astro';
import Base from '../layouts/Base.astro';
import { getSiteData } from '../lib/content';
import { featuredProjects, homePosts } from '../lib/selectors';

const site = await getSiteData();
const { profile } = site;
const projects = featuredProjects(site.projects);
---

<Base
  title={siteConfig.name}
  description={profile.bio ?? `${profile.role} in ${profile.location}`}
  current="home"
  path="~/lil.horse"
>
  <CommandBlock full command="neofetch" heading={{ level: 1, text: profile.name }}>
    <Neofetch profile={profile} />
  </CommandBlock>
  {projects.length > 0 && (
    <CommandBlock command="ls ~/projects" heading={{ level: 2, text: 'Projects' }}>
      <ProjectList projects={projects} />
    </CommandBlock>
  )}
  <CommandBlock command="ls -lt ~/blog" pipe="| head" heading={{ level: 2, text: 'Latest posts' }}>
    <PostList posts={homePosts(site.posts)} tags={site.tagSlugs} variant="files" />
  </CommandBlock>
</Base>
