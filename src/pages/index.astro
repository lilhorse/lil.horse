---
import { getCollection } from 'astro:content';

const posts = await getCollection('posts');
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>lil.horse</title>
  </head>
  <body>
    <ul>
      {posts.map((post) => (
        <li>{post.data.title}</li>
      ))}
    </ul>
  </body>
</html>
