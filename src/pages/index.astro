---
import { getCollection } from 'astro:content';

const entries = await getCollection('smoke');
const title: string = entries[0]?.data.title ?? 'missing';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>{title}</title>
  </head>
  <body>
    <h1>{title}</h1>
  </body>
</html>
