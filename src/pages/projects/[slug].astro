---
import Blocks from '../../components/blocks/Blocks.astro';
import Picture from '../../components/blocks/Picture.astro';
import AdjacentNav from '../../components/shell/AdjacentNav.astro';
import DocHeader from '../../components/shell/DocHeader.astro';
import DocLayout from '../../components/shell/DocLayout.astro';
import Base from '../../layouts/Base.astro';
import { getSiteData } from '../../lib/content';
import { relFor } from '../../lib/html';
import { ogImagePath } from '../../lib/og';
import { adjacentProjects, projectLinks } from '../../lib/selectors';
import type { PageContent, ProjectEntry } from '../../notion/types';

type ProjectPage = ProjectEntry & { slug: string; content: PageContent };

export async function getStaticPaths() {
  const site = await getSiteData();
  return site.projects
    .filter((project): project is ProjectPage => Boolean(project.slug && project.content))
    .map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

interface Props {
  project: ProjectPage;
}

const { project } = Astro.props;
const site = await getSiteData();
const { previous, next } = adjacentProjects(site.projects, project.slug);
const links = projectLinks(project);
const neighbour = (entry: ProjectEntry | null) =>
  entry?.slug ? { href: `/projects/${entry.slug}`, title: entry.name } : null;
---

<Base
  title={project.name}
  description={project.description}
  hasMath={project.content.hasMath}
  path={`~/projects/${project.slug}.md`}
  file={`${project.slug}.md`}
  wide
  image={ogImagePath('projects', project.slug)}
>
  <DocLayout headings={project.content.headings} search={{ type: 'project' }}>
    <DocHeader command={`cat ~/projects/${project.slug}.md`} title={project.name}>
      {(project.year || project.status || project.stack.length > 0) && (
        <div class="doc-meta" slot="meta" data-pagefind-ignore>
          {project.year && <span>{project.year}</span>}
          {project.status && (
            <Fragment>
              {project.year && <span class="sep"> · </span>}
              <span class={`status status-${project.status.toLowerCase()}`}>{project.status}</span>
            </Fragment>
          )}
          {project.stack.length > 0 && (
            <Fragment>
              {(project.year || project.status) && <span class="sep"> · </span>}
              <span>{project.stack.join(' · ')}</span>
            </Fragment>
          )}
        </div>
      )}
      <p class="lead">{project.description}</p>
      {links.length > 0 && (
        <ul class="links" data-pagefind-ignore>
          {links.map((link, index) => (
            <Fragment>
              {index > 0 && ' '}
              <li>
                <a href={link.href} rel={relFor(link.href)}>
                  <span aria-hidden="true">↗</span> <span class="label">{link.label}</span>
                </a>
              </li>
            </Fragment>
          ))}
        </ul>
      )}
    </DocHeader>
    {project.cover && (
      <div class="doc-cover">
        <Picture media={project.cover} alt="" priority />
      </div>
    )}
    <div class="prose">
      <Blocks
        nodes={project.content.blocks}
        resolve={site.resolve}
        headings={project.content.headings}
        priorityImageId={project.cover ? null : project.content.priorityImageId}
      />
    </div>
    <AdjacentNav
      slot="after"
      label="Adjacent projects"
      previous={neighbour(previous)}
      next={neighbour(next)}
      previousLabel="previous"
      nextLabel="next"
    />
  </DocLayout>
</Base>

<style>
  .doc-meta {
    color: var(--muted);
    font-size: var(--text-ui);
  }
  .status-active {
    color: var(--ok);
  }
  .status-maintained {
    color: var(--accent);
  }
  .lead {
    color: var(--fg-soft);
    font-family: var(--font-sans);
    font-size: var(--text-body);
    line-height: 1.6;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .links a {
    text-decoration-line: none;
    display: inline-flex;
    gap: 0.5ch;
    align-items: center;
    min-block-size: 24px;
  }
  .links a:hover .label {
    text-decoration-line: underline;
  }
  @media (max-width: 639.98px) {
    .links a {
      min-block-size: 44px;
      min-inline-size: 44px;
    }
  }
</style>
