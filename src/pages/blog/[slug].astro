---
import Blocks from '../../components/blocks/Blocks.astro';
import Picture from '../../components/blocks/Picture.astro';
import AdjacentNav from '../../components/shell/AdjacentNav.astro';
import Comments from '../../components/shell/Comments.astro';
import DocHeader from '../../components/shell/DocHeader.astro';
import DocLayout from '../../components/shell/DocLayout.astro';
import TagList from '../../components/shell/TagList.astro';
import { siteConfig } from '../../../site.config';
import Base from '../../layouts/Base.astro';
import { getSiteData } from '../../lib/content';
import { htmlLang } from '../../lib/lang';
import { ogImagePath } from '../../lib/og';
import { adjacentPosts } from '../../lib/selectors';
import { absoluteUrl, blogPostingJsonLd, breadcrumbJsonLd } from '../../lib/seo';
import type { PostEntry } from '../../notion/types';

export async function getStaticPaths() {
  const site = await getSiteData();
  return site.posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

interface Props {
  post: PostEntry;
}

const { post } = Astro.props;
const site = await getSiteData();
const { previous, next } = adjacentPosts(site.posts, post.slug);
const lang = post.language === 'zh' ? 'zh-Hans' : 'en';
const crumbs = breadcrumbJsonLd([
  { name: siteConfig.name, url: siteConfig.url },
  { name: 'Blog', url: absoluteUrl('/blog', siteConfig.url) },
  { name: post.title, url: absoluteUrl(`/blog/${post.slug}`, siteConfig.url) },
]);
const neighbour = (entry: PostEntry | null) =>
  entry && { href: `/blog/${entry.slug}`, title: entry.title, lang: htmlLang(entry.language) };
---

<Base
  title={post.title}
  description={post.description}
  noindex={post.status !== 'Published'}
  hasMath={post.content.hasMath}
  path={`~/blog/${post.slug}.md`}
  file={`${post.slug}.md`}
  wide
  type="article"
  image={ogImagePath('blog', post.slug)}
  article={{ published: post.published, modified: post.updated, tags: post.tags }}
  jsonLd={[blogPostingJsonLd(post, site.profile, siteConfig.url), crumbs]}
>
  <DocLayout
    headings={post.content.headings}
    lang={lang}
    search={post.status === 'Published' ? { type: 'post' } : null}
  >
    <DocHeader command={`cat ~/blog/${post.slug}.md`} title={post.title}>
      <div class="doc-meta" slot="meta" data-pagefind-ignore>
        <time datetime={post.published} data-pagefind-meta="date">
          {post.published}
        </time>{' '}
        <span class="sep">·</span> {post.readingMinutes} min read
        {post.status === 'Draft' && (
          <Fragment>
            {' '}
            <span class="draft">DRAFT</span>
          </Fragment>
        )}
        {post.tags.length > 0 && (
          <Fragment>
            {' '}
            <span class="sep">·</span> <TagList tags={post.tags} linked={site.tagSlugs} />
          </Fragment>
        )}
      </div>
    </DocHeader>
    {post.cover && (
      <div class="doc-cover">
        <Picture media={post.cover} alt="" priority />
      </div>
    )}
    <div class="prose">
      <Blocks
        nodes={post.content.blocks}
        resolve={site.resolve}
        headings={post.content.headings}
        priorityImageId={post.cover ? null : post.content.priorityImageId}
      />
    </div>
    {post.updated && (
      <p class="doc-updated" data-pagefind-ignore>
        Updated <time datetime={post.updated}>{post.updated}</time>
      </p>
    )}
    <Fragment slot="after">
      <AdjacentNav
        label="Adjacent posts"
        previous={neighbour(previous)}
        next={neighbour(next)}
        previousLabel="older"
        nextLabel="newer"
      />
      <Comments slug={post.slug} />
    </Fragment>
  </DocLayout>
</Base>

<style>
  .doc-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    align-items: center;
    color: var(--muted);
    font-size: var(--text-ui);
  }
  .draft {
    padding: 0 6px;
    border-radius: 4px;
    background: var(--hl-pink);
    color: var(--fg);
    font-weight: 600;
  }
  .doc-updated {
    margin-block-start: 32px;
    color: var(--muted);
    font-size: var(--text-ui);
  }
</style>
