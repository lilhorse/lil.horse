---
import CommandBlock from '../../components/shell/CommandBlock.astro';
import PostList from '../../components/shell/PostList.astro';
import Base from '../../layouts/Base.astro';
import { getSiteData } from '../../lib/content';
import { postsByYear } from '../../lib/selectors';

const site = await getSiteData();
const years = postsByYear(site.posts);
---

<Base title="Blog" description="All posts" current="blog" path="~/blog">
  <CommandBlock command="ls -lt ~/blog" heading={{ level: 1, text: 'Blog' }}>
    {years.length === 0 ? (
      <PostList posts={[]} tags={site.tagSlugs} variant="titles" />
    ) : (
      years.map((group) => (
        <section class="year" aria-labelledby={`year-${group.year}`}>
          <h2 id={`year-${group.year}`}>
            <span aria-hidden="true">── </span>
            {group.year}
          </h2>
          <PostList posts={group.posts} tags={site.tagSlugs} variant="titles" date="month-day" />
        </section>
      ))
    )}
  </CommandBlock>
</Base>

<style>
  .year + .year {
    margin-block-start: 20px;
  }
  h2 {
    margin-block-end: 4px;
    color: var(--muted);
    font-size: var(--text-ui);
    font-weight: 400;
  }
</style>
