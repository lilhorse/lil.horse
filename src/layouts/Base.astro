---
import { Font } from 'astro:assets';
import { siteConfig } from '../../site.config';
import SiteFooter from '../components/shell/SiteFooter.astro';
import SiteHeader from '../components/shell/SiteHeader.astro';
import { siteVersion } from '../lib/build-info';
import { getSiteData } from '../lib/content';
import { KATEX_STYLESHEET } from '../lib/katex';
import { socialLinks } from '../lib/profile';
import { SPECULATION_RULES } from '../lib/speculation';
import { THEME_INIT_SCRIPT } from '../lib/theme-init';
import type { Section } from '../lib/shell';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/prose.css';

interface Props {
  title: string;
  description?: string | null;
  noindex?: boolean;
  hasMath?: boolean;
  canonical?: boolean;
  path: string;
  current?: Section | null;
  file?: string | null;
  wide?: boolean;
}

// Element ids used in this layout must also be in LAYOUT_IDS in src/notion/page-content.ts.
const {
  title,
  description = null,
  noindex = false,
  hasMath = false,
  canonical = true,
  path,
  current = null,
  file = null,
  wide = false,
} = Astro.props;
const site = await getSiteData();
const pageTitle = title === siteConfig.name ? title : `${title} · ${siteConfig.name}`;
// With build.format 'file', Astro.url.pathname ends in .html at build time.
const canonicalPath = Astro.url.pathname.replace(/\/index\.html$/, '/').replace(/\.html$/, '');
const canonicalUrl = new URL(canonicalPath, siteConfig.url).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    {description && <meta name="description" content={description} />}
    {canonical && <link rel="canonical" href={canonicalUrl} />}
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#e6e9ef" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#16161e" media="(prefers-color-scheme: dark)" />
    <script is:inline set:html={THEME_INIT_SCRIPT} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="alternate" type="application/rss+xml" title={siteConfig.name} href="/feed.xml" />
    <Font cssVariable="--font-jetbrains-mono" preload={[{ weight: 400, style: 'normal' }]} />
    <Font cssVariable="--font-ibm-plex-sans" preload={[{ weight: 400, style: 'normal' }]} />
    {hasMath && <link rel="stylesheet" href={KATEX_STYLESHEET} />}
    <script>
      import '../scripts/entry';
    </script>
    <script type="speculationrules" set:html={SPECULATION_RULES} />
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <SiteHeader current={current} path={path} file={file} />
    <main id="main" class={wide ? 'wide' : undefined}>
      <slot />
    </main>
    <SiteFooter social={socialLinks(site.profile)} version={siteVersion()} />
  </body>
</html>
