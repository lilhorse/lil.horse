---
import { Font } from 'astro:assets';
import { siteConfig } from '../../site.config';
import { KATEX_STYLESHEET } from '../lib/katex';
import '../styles/tokens.css';
import '../styles/base.css';

interface Props {
  title: string;
  description?: string | null;
  noindex?: boolean;
  hasMath?: boolean;
  canonical?: boolean;
}

// Element ids used in this layout must also be in LAYOUT_IDS in src/notion/page-content.ts.
const {
  title,
  description = null,
  noindex = false,
  hasMath = false,
  canonical = true,
} = Astro.props;
const pageTitle = title === siteConfig.name ? title : `${title} · ${siteConfig.name}`;
// With build.format 'file', Astro.url.pathname ends in .html at build time.
const canonicalPath = Astro.url.pathname.replace(/\/index\.html$/, '/').replace(/\.html$/, '');
const canonicalUrl = new URL(canonicalPath, siteConfig.url).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    {description && <meta name="description" content={description} />}
    {canonical && <link rel="canonical" href={canonicalUrl} />}
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#e6e9ef" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#16161e" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <Font cssVariable="--font-jetbrains-mono" preload={[{ weight: 400, style: 'normal' }]} />
    <Font cssVariable="--font-ibm-plex-sans" preload={[{ weight: 400, style: 'normal' }]} />
    {hasMath && <link rel="stylesheet" href={KATEX_STYLESHEET} />}
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <header>
      <nav aria-label="Primary">
        <a href="/">~/lil.horse</a> <a href="/blog">blog</a> <a href="/projects">projects</a>{' '}
        <a href="/about">about</a> <a href="/contact">contact</a>
      </nav>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer>
      <p>exit 0</p>
      <p>
        © Lil'Horse · Content{' '}
        <a href="https://creativecommons.org/licenses/by-nc/4.0/" rel="license">
          CC BY-NC 4.0
        </a>{' '}
        · Code <a href="https://github.com/lilhorse/lil.horse/blob/main/LICENSE">MIT</a>
      </p>
    </footer>
  </body>
</html>
